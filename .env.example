# Copy to .env and fill in. Never commit .env — it holds tokens.

# --- Baserow: your Library table (Setup 1) ---
# Token: Baserow -> My Settings -> Database tokens (needs create/read/update on the table)
BASEROW_API_TOKEN=
# Numeric table id — visible in the table's URL
BASEROW_TABLE_ID=
# Self-hosted Baserow? Point this at your instance.
BASEROW_API_URL=https://api.baserow.io

# --- YouTube: your Learn playlist (Setup 3, Door 1) ---
# The part after list= in the playlist URL; starts with PL.
# The playlist must be Unlisted and sorted by "Date added (newest)".
YT_PLAYLIST_ID=

# --- Telegram: your bot (Setup 3, Door 2) ---
# From @BotFather (/newbot). This token is a password — if it leaks, send
# /token to BotFather to rotate it.
TELEGRAM_BOT_TOKEN=
# The "chat":{"id":...} number from /getUpdates after messaging your bot
TELEGRAM_CHAT_ID=

# --- Claude API: used by the sort step to classify saves into subjects ---
ANTHROPIC_API_KEY=
